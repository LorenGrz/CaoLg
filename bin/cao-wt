#!/usr/bin/env bash
# cao-wt: lanza una sesión de CaoLg.
#   cao-wt <repo> <slug> [perfil]        worktree aislado + rama agent/<slug> (default: supervisor)
#   cao-wt --dir <carpeta> <slug> [perfil]  carpeta sin git: los agentes trabajan ahí mismo, sin worktree
#   cao-wt --rm <repo> <slug>            cierra la sesión y borra el worktree
#   cao-wt --rm --dir <carpeta> <slug>   cierra la sesión (la carpeta no se toca)
set -euo pipefail

usage() { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

rm_mode=0 dir_mode=0
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --rm) rm_mode=1 ;;
    --dir) dir_mode=1 ;;
    --help) usage 0 ;;
    *) usage ;;
  esac
  shift
done
[[ "${1:-}" == "-h" ]] && usage 0
[[ $# -ge 2 ]] || usage

slug=$2
profile=${3:-supervisor}
here=$(dirname "$(realpath "$0")")

if [[ $dir_mode -eq 1 ]]; then
  wt=$(cd "$1" && pwd)
  name=$(basename "$wt")
  branch="sin git"
else
  repo=$(cd "$1" && git rev-parse --show-toplevel)
  name=$(basename "$repo")
  wt="$(dirname "$repo")/$name-wt/$slug"
  branch="agent/$slug"
fi

if [[ $rm_mode -eq 1 ]]; then
  cao shutdown --session "cao-$slug" || echo "aviso: no había sesión cao-$slug" >&2
  if [[ $dir_mode -eq 0 ]]; then
    git -C "$repo" worktree remove "$wt"   # falla si hay cambios sin commitear: es a propósito
    echo "worktree $wt eliminado. La rama $branch se conserva (borrala con: git -C $repo branch -d $branch)"
  fi
  exit 0
fi

if [[ $dir_mode -eq 1 ]]; then
  # Sin worktree el líder edita sin confirmaciones directo en la carpeta: frenar en lugares amplios.
  if [[ "$wt" == "$HOME" || "$wt" == / ]]; then
    read -r -p "caolg: vas a abrir agentes sin confirmaciones sobre $wt entero. ¿Seguro? [y/N] " ok
    [[ "$ok" == [yY]* ]] || exit 1
  fi
fi

if ! curl -fsS -o /dev/null http://localhost:9889/health 2>/dev/null; then
  # Levantarlo en segundo plano, independiente de esta terminal (log en ~/.cache/caolg/cao-server.log).
  mkdir -p ~/.cache/caolg
  echo "caolg: levantando cao-server…" >&2
  # pidfile: caolg-close lo apaga cuando se cierra la última sesión (solo si lo levantó caolg).
  setsid -f bash -c 'echo $$ > ~/.cache/caolg/cao-server.pid; exec cao-server' >>~/.cache/caolg/cao-server.log 2>&1 </dev/null
  for _ in $(seq 30); do curl -fsS -o /dev/null http://localhost:9889/health 2>/dev/null && break; sleep 1; done
  curl -fsS -o /dev/null http://localhost:9889/health 2>/dev/null \
    || { echo "cao-server no arrancó; mirá ~/.cache/caolg/cao-server.log" >&2; exit 1; }
fi

if [[ $dir_mode -eq 0 ]]; then
  if [[ ! -d "$wt" ]]; then
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo" worktree add "$wt" "$branch"      # la rama ya existe (worktree borrado antes)
    else
      git -C "$repo" worktree add "$wt" -b "$branch"
    fi
  fi
  # Las tareas que escribe el líder no se commitean (exclude local del repo, no toca .gitignore).
  excl="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$excl")"
  grep -qxF '.caolg-tasks/' "$excl" 2>/dev/null || echo '.caolg-tasks/' >> "$excl"
fi

# Roles por carpeta y estado de Opus fuera del proyecto: sobreviven a los worktrees y no lo ensucian.
data="$HOME/.local/share/caolg/$name"
roles="$data/agents"
state="$data/$slug/state.md"
mkdir -p "$roles" "$(dirname "$state")"

cd "$wt"
# cao-mcp-server de los agentes de Claude, con scope de usuario (los perfiles no definen mcpServers para que
# CAO no use --strict-mcp-config y conserven los conectores). Fuera de CAO es un MCP vacío. Ver bin/caolg-mcp.
"$here/caolg-mcp" --ensure || echo "caolg: no pude registrar cao-mcp-server (los agentes no podrán hablarse)" >&2
# Layout, tema, atajos, saludo y watcher, en segundo plano mientras CAO se adjunta a la sesión.
setsid -f "$here/caolg-session" "cao-$slug" "$wt" "$branch" "$state" "$roles" </dev/null >/dev/null 2>&1

# --auto-approve solo salta el "Proceed? [Y/n]" de CAO; no cambia la política de herramientas (nunca --yolo).
exec cao launch --agents "$profile" --session-name "$slug" --auto-approve \
  --env "CAOLG_ROLES_DIR=$roles" --env "CAOLG_STATE=$state"
