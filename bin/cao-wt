#!/usr/bin/env bash
# cao-wt: un worktree aislado por sesión de CAO.
#   cao-wt <repo> <slug> [perfil]   crea worktree + rama agent/<slug> y lanza CAO adentro (default: supervisor)
#   cao-wt --rm <repo> <slug>       cierra la sesión y borra el worktree
set -euo pipefail

usage() { sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

rm_mode=0
if [[ "${1:-}" == "--rm" ]]; then rm_mode=1; shift; fi
[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && usage 0
[[ $# -ge 2 ]] || usage

repo=$(cd "$1" && git rev-parse --show-toplevel)
slug=$2
profile=${3:-supervisor}
name=$(basename "$repo")
wt="$(dirname "$repo")/$name-wt/$slug"
branch="agent/$slug"
here=$(dirname "$(realpath "$0")")

if [[ $rm_mode -eq 1 ]]; then
  cao shutdown --session "cao-$slug" || echo "aviso: no había sesión cao-$slug" >&2
  git -C "$repo" worktree remove "$wt"   # falla si hay cambios sin commitear: es a propósito
  echo "worktree $wt eliminado. La rama $branch se conserva (borrala con: git -C $repo branch -d $branch)"
  exit 0
fi

curl -fsS -o /dev/null http://localhost:9889/health 2>/dev/null \
  || { echo "cao-server no responde en :9889. Levantalo en otra terminal: caolg server" >&2; exit 1; }

if [[ ! -d "$wt" ]]; then
  git -C "$repo" worktree add "$wt" -b "$branch"
fi
# Las tareas que escribe el líder no se commitean (exclude local del repo, no toca .gitignore).
excl="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
mkdir -p "$(dirname "$excl")"
grep -qxF '.caolg-tasks/' "$excl" 2>/dev/null || echo '.caolg-tasks/' >> "$excl"

# Roles por carpeta y estado de Opus fuera del repo: sobreviven a los worktrees y no ensucian el proyecto.
data="$HOME/.local/share/caolg/$name"
roles="$data/agents"
state="$data/$slug/state.md"
mkdir -p "$roles" "$(dirname "$state")"

cd "$wt"
# Layout, tema, atajos, saludo y watcher, en segundo plano mientras CAO se adjunta a la sesión.
setsid -f "$here/caolg-session" "cao-$slug" "$wt" "$branch" "$state" "$roles" </dev/null >/dev/null 2>&1

# --auto-approve solo salta el "Proceed? [Y/n]" de CAO; no cambia la política de herramientas (nunca --yolo).
exec cao launch --agents "$profile" --session-name "$slug" --auto-approve \
  --env "CAOLG_ROLES_DIR=$roles" --env "CAOLG_STATE=$state"
