#!/usr/bin/env bash
# caolg (alias: claudes): punto de entrada único.
#   claudes                              desde la carpeta actual, en esta terminal; cada vez una sesión nueva, como
#                                          claude (si cao-<x> ya está abierta: cao-<x>-2, -3…; volver a una: Alt+↑/↓):
#                                          repo git -> worktree aislado <repo>-wt/<slug> + sesión cao-<slug>
#                                          carpeta sin git -> trabaja ahí mismo, como claude, sesión cao-<carpeta>
#   claudes open [<repo> <slug>]         lo mismo en una terminal nueva (sin args: carpeta actual)
#   claudes here <repo> <slug> [perfil]  repo y nombre explícitos, en esta terminal
#   claudes rm [<repo> <slug>]           cierra la sesión (y borra el worktree si es repo); sin args: carpeta actual
#   claudes ls                           sesiones activas
#   claudes usage [--json]               uso y login por suscripción
#   claudes server                       levanta cao-server en primer plano
set -euo pipefail
me=$(basename "$0")

# Define: target (repo o carpeta), slug y mode (repo|dir), a partir de la carpeta actual.
from_cwd() {
  local top common main
  if top=$(git rev-parse --show-toplevel 2>/dev/null); then
    common=$(git rev-parse --path-format=absolute --git-common-dir)
    main=$(dirname "$common")                   # checkout principal, aunque estés en un worktree
    mode=repo target=$main
    if [[ "$(dirname "$top")" == "$main-wt" ]]; then
      slug=$(basename "$top")                   # ya estás en un worktree de caolg: esa sesión
    else
      slug=$(basename "$main")
    fi
  else
    mode=dir target=$PWD slug=$(basename "$PWD")
    [[ "$PWD" == / ]] && slug=root
  fi
  slug=$(printf '%s' "$slug" | tr -c 'A-Za-z0-9_-' '-')
}

# Sesión nueva como claude: si cao-<slug> está abierta en alguna terminal, usar <slug>-2, -3… (ADR 0009).
free_slug() {
  local base=$slug n=1
  # Ojo: tmux display sobre una sesión inexistente sale con 0 y vacío; por eso has-session primero.
  while tmux has-session -t "=cao-$slug" 2>/dev/null \
    && [[ "$(tmux display -p -t "=cao-$slug:" '#{session_attached}')" != 0 ]]; do
    n=$((n + 1)); slug="$base-$n"
  done
}

launch() {  # $1 = here|open
  free_slug
  if tmux has-session -t "=cao-$slug" 2>/dev/null && [[ -n "$(tmux show -qv -t "=cao-$slug:" @caolg_wt)" ]]; then
    # Arrancar de 0: una sesión de caolg que quedó viva sin terminales se cierra (sin guardar estado).
    "$(dirname "$(realpath "$0")")/caolg-close" "cao-$slug" >/dev/null 2>&1 || true
  fi
  if tmux has-session -t "=cao-$slug" 2>/dev/null; then
    # Sesión de CAO que no abrió caolg (sin layout, barra ni saludo): no adjuntarse en silencio.
    if [[ -z "$(tmux show -qv -t "=cao-$slug:" @caolg_wt)" ]]; then
      echo "$me: cao-$slug es una sesión de CAO que no abrió caolg (sin layout, barra ni saludo)." >&2
      echo "  Cerrala con:  cao shutdown --session cao-$slug   y volvé a correr: $me" >&2
      echo "  O entrá igual: tmux attach -t =cao-$slug" >&2
      exit 1
    fi
    if [[ "$1" == open ]]; then exec cao-open "$target" "$slug"
    elif [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "=cao-$slug"
    else exec tmux attach -t "=cao-$slug"; fi
  fi
  local dirflag=()
  [[ $mode == dir ]] && dirflag=(--dir)
  if [[ "$1" == open ]]; then exec cao-open "${dirflag[@]}" "$target" "$slug"
  else exec cao-wt "${dirflag[@]}" "$target" "$slug"; fi
}

help() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; }

cmd=${1:-}
case "$cmd" in
  "")     from_cwd; launch here ;;
  open)   shift; if [[ $# -eq 0 ]]; then from_cwd; launch open; else exec cao-open "$@"; fi ;;
  here)   shift; exec cao-wt "$@" ;;
  rm)     shift
          if [[ $# -gt 0 ]]; then exec cao-wt --rm "$@"; fi
          from_cwd
          if [[ $mode == dir ]]; then exec cao-wt --rm --dir "$target" "$slug"; else exec cao-wt --rm "$target" "$slug"; fi ;;
  ls)     exec cao-ls ;;
  usage)  shift; exec cao-usage "$@" ;;
  server) exec cao-server ;;
  -h|--help|help) help ;;
  *)      echo "$me: comando desconocido: $cmd" >&2; help; exit 1 ;;
esac
