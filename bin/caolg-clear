#!/usr/bin/env bash
# caolg-clear <session>: Opus guarda su estado en $CAOLG_STATE, se hace /clear y lo relee.
# Lo dispara Alt+c (manual) o caolg-watch cuando el contexto pasa CAOLG_CLEAR_AT (automático).
set -uo pipefail
s=$1
mkdir -p ~/.cache/caolg
exec 9>~/.cache/caolg/"$s".clear.lock
flock -n 9 || { tmux display -t "$s" "caolg: ya hay un /clear en curso"; exit 0; }

state=$(tmux show -v -t "$s" @caolg_state 2>/dev/null)
[[ -n "$state" ]] || { tmux display -t "$s" "caolg: la sesión no tiene @caolg_state"; exit 1; }
mkdir -p "$(dirname "$state")"

tmux display -t "$s" "caolg: Opus está guardando su estado antes del /clear…"
cao session send "$s" --timeout 300 \
  "Voy a limpiar tu contexto. Antes, sobrescribí $state con el estado actual en markdown: objetivo, decisiones tomadas, workers abiertos (rol, provider, tarea, estado), archivos clave y próximos pasos. Respondé solo LISTO cuando esté escrito." \
  >/dev/null 2>&1 || { tmux display -t "$s" "caolg: Opus no respondió; cancelo el /clear"; exit 1; }

[[ -s "$state" ]] || { tmux display -t "$s" "caolg: $state quedó vacío; cancelo el /clear"; exit 1; }

# Pane de Opus: el que caolg-watch etiquetó como líder (fallback: primer pane de la ventana caolg).
pane=$(tmux list-panes -s -t "$s" -F '#{pane_id} #{@caolg_label}' | awk '/Opus/ {print $1; exit}')
pane=${pane:-$s:caolg.1}
tmux send-keys -t "$pane" "/clear"
sleep 0.5
tmux send-keys -t "$pane" Enter
sleep 3

cao session send "$s" --async \
  "Retomá: leé $state, resumime en 2 líneas dónde estábamos y seguí con los próximos pasos. Tus roles por carpeta siguen en \$CAOLG_ROLES_DIR." \
  >/dev/null 2>&1
tmux display -t "$s" "caolg: contexto de Opus limpio, retomando desde $state"
