#!/usr/bin/env python3
"""cao-usage: uso de tokens/costo y estado de login por suscripción.

  cao-usage [--since YYYYMMDD] [--json] [--refresh-auth]

Sin --since usa hoy. Login (cacheado 5 min en ~/.cache/caolg/auth.json):
  claude   -> `claude auth status`        codex    -> `codex login status`
  opencode -> `opencode auth list`        copilot / antigravity -> no tienen comando de estado:
  se toman como logueados si hubo uso en los últimos 7 días.
Forzar a mano en ~/.config/caolg/auth.toml, p. ej.:  copilot = true   codex = false
Cupos (`limits`: ventana, % usado, reset) según lo que expone cada CLI:
  claude  -> ~/.cache/claude/rate-limits.json (lo escribe la statusline de Claude Code): 5h y 7d
  codex   -> último evento token_count de ~/.codex/sessions/**/rollout-*.jsonl: primary/secondary
  copilot -> `gh api /copilot_internal/user` (cache 5 min): pedidos premium del mes
  agy / opencode -> no exponen cupo: n/d
`quota_pct_used` = la ventana más gastada. Para probar la rotación:
  CAO_USAGE_OVERRIDE='{"codex": 95}' cao-usage --json
"""
import argparse
import datetime
import json
import os
import re
import subprocess
import sys
import time
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import caolg_lib as L  # noqa: E402

# agente de ccusage -> worker de CAO
AGENTS = {
    "claude": "claude-dev",
    "codex": "codex-dev",
    "antigravity": "gemini-dev",
    "opencode": "opencode-dev",
    "copilot": "copilot-dev",
}
LOGIN_HINT = {
    "claude": "claude  (y /login)",
    "codex": "codex login",
    "antigravity": "agy  (abrirlo una vez e iniciar sesión con Google)",
    "opencode": "opencode auth login",
    "copilot": "copilot login",
}
AUTH_CACHE = Path.home() / ".cache/caolg/auth.json"
AUTH_OVERRIDE = Path.home() / ".config/caolg/auth.toml"
AUTH_TTL = 300
CLAUDE_LIMITS = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "claude/rate-limits.json"
CODEX_SESSIONS = Path.home() / ".codex/sessions"
COPILOT_CACHE = Path.home() / ".cache/caolg/copilot-quota.json"


def run(cmd, timeout=30):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return out.returncode, re.sub(r"\x1b\[[0-9;]*m", "", out.stdout + out.stderr)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None, ""


def query(agent, since):
    """Devuelve (tokens, cost, status). Lo que no se pueda leer queda en None, nunca inventado."""
    try:
        out = subprocess.run(
            ["ccusage", agent, "daily", "--json", "--since", since],
            capture_output=True, text=True, timeout=90,
        )
        if out.returncode != 0:
            return None, None, "error"
        totals = json.loads(out.stdout).get("totals") or {}
    except FileNotFoundError:
        return None, None, "sin-ccusage"
    except (subprocess.TimeoutExpired, json.JSONDecodeError):
        return None, None, "error"
    tokens = totals.get("totalTokens")
    cost = totals.get("totalCost", totals.get("costUSD"))
    if tokens is None and cost is None:
        return None, None, "n/d"
    return tokens, cost, "ok"


def check_login(agent):
    """(logged_in: True/False/None, fuente). Nunca lee tokens: solo estado o evidencia de uso."""
    if agent == "claude":
        rc, out = run(["claude", "auth", "status"])
        if rc is None:
            return None, "claude no responde"
        return bool(re.search(r'"loggedIn"\s*:\s*true', out)), "claude auth status"
    if agent == "codex":
        rc, out = run(["codex", "login", "status"])
        if rc is None:
            return None, "codex no responde"
        return ("not logged in" not in out.lower() and rc == 0), "codex login status"
    if agent == "opencode":
        rc, out = run(["opencode", "auth", "list"])
        if rc is None:
            return None, "opencode no responde"
        return (len(re.findall(r"\bstored\b", out)) > 0), "opencode auth list"
    # copilot / antigravity: evidencia de uso reciente
    week = (datetime.date.today() - datetime.timedelta(days=7)).strftime("%Y%m%d")
    tokens, _, status = query(agent, week)
    if status != "ok":
        return None, "sin datos"
    return (bool(tokens) or None), "uso en los últimos 7 días"


def login_status(refresh=False):
    cache = {}
    try:
        cache = json.loads(AUTH_CACHE.read_text())
    except (OSError, json.JSONDecodeError):
        pass
    if refresh or time.time() - cache.get("ts", 0) > AUTH_TTL:
        cache = {"ts": time.time(), "agents": {a: list(check_login(a)) for a in AGENTS}}
        AUTH_CACHE.parent.mkdir(parents=True, exist_ok=True)
        AUTH_CACHE.write_text(json.dumps(cache))
    result = {a: tuple(v) for a, v in cache["agents"].items()}
    try:
        with open(AUTH_OVERRIDE, "rb") as f:
            for a, v in tomllib.load(f).items():
                if a in AGENTS and isinstance(v, bool):
                    result[a] = (v, "forzado en auth.toml")
    except (OSError, tomllib.TOMLDecodeError):
        pass
    return result


def read_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError):
        return None


def codex_event():
    """Último token_count con rate_limits del rollout más reciente de Codex (o None)."""
    try:
        files = sorted(CODEX_SESSIONS.rglob("rollout-*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True)
    except OSError:
        return None
    for f in files[:3]:
        try:
            lines = f.read_text(errors="ignore").splitlines()
        except OSError:
            continue
        for line in reversed(lines):
            if '"rate_limits"' in line:
                try:
                    return json.loads(line)
                except json.JSONDecodeError:
                    continue
    return None


def copilot_user():
    """Solo los campos de cupo de `gh api /copilot_internal/user`, cacheados 5 min (gh maneja el token)."""
    cached = read_json(COPILOT_CACHE)
    if cached and time.time() - cached.get("ts", 0) < AUTH_TTL:
        return cached
    rc, out = run(["gh", "api", "/copilot_internal/user", "--jq",
                   "{quota_reset_date, quota_reset_date_utc, quota_snapshots}"], timeout=20)
    try:
        data = json.loads(out) if rc == 0 else None
    except json.JSONDecodeError:
        data = None
    if data is None:
        return cached
    data["ts"] = time.time()
    COPILOT_CACHE.parent.mkdir(parents=True, exist_ok=True)
    COPILOT_CACHE.write_text(json.dumps(data))
    return data


def limits(agent):
    if agent == "claude":
        return L.claude_limits(read_json(CLAUDE_LIMITS))
    if agent == "codex":
        return L.codex_limits(codex_event())
    if agent == "copilot":
        return L.copilot_limits(copilot_user())
    return []


def main():
    ap = argparse.ArgumentParser(description="Uso y login por suscripción")
    ap.add_argument("--since", default=datetime.date.today().strftime("%Y%m%d"))
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--refresh-auth", action="store_true")
    args = ap.parse_args()

    try:
        override = json.loads(os.environ.get("CAO_USAGE_OVERRIDE", "{}") or "{}")
    except json.JSONDecodeError:
        sys.exit("CAO_USAGE_OVERRIDE no es JSON válido")

    logins = login_status(args.refresh_auth)
    rows = []
    for agent, worker in AGENTS.items():
        tokens, cost, status = query(agent, args.since)
        logged, source = logins.get(agent, (None, "sin datos"))
        lims = limits(agent) if logged is not False else []
        live = [w["pct"] for w in lims if not (w.get("resets_at") and w["resets_at"] <= time.time())]
        rows.append({
            "agent": agent,
            "worker": worker,
            "logged_in": logged,
            "auth_source": source,
            "login_hint": None if logged else LOGIN_HINT[agent],
            "tokens": tokens,
            "cost_usd": None if cost is None else round(cost, 2) + 0.0,  # +0.0 evita "-0.00"
            "quota_pct_used": override.get(agent, max(live) if live else None),
            "limits": lims,
            "status": status,
        })

    if args.json:
        print(json.dumps({"since": args.since, "providers": rows}, indent=2))
        return

    print(f"Uso desde {args.since}  (cupo %: n/d salvo override)")
    print(f"{'agente':<12}{'worker':<17}{'login':<7}{'tokens':>14}{'costo USD':>11}{'cupo %':>8}  estado")
    for r in rows:
        tok = "n/d" if r["tokens"] is None else f"{r['tokens']:,}"
        cost = "n/d" if r["cost_usd"] is None else f"{r['cost_usd']:.2f}"
        pct = "n/d" if r["quota_pct_used"] is None else str(r["quota_pct_used"])
        login = {True: "sí", False: "no", None: "?"}[r["logged_in"]]
        print(f"{r['agent']:<12}{r['worker']:<17}{login:<7}{tok:>14}{cost:>11}{pct:>8}  {r['status']}")
    missing = [r for r in rows if not r["logged_in"]]
    if missing:
        print("\nSin login (el líder no los usa):")
        for r in missing:
            print(f"  {r['agent']:<12} → {r['login_hint']}")


if __name__ == "__main__":
    main()
