#!/usr/bin/env bash
# caolg-layout <session>: Opus en la mitad izquierda (50%) y una sola tab visible a la derecha (bin/caolg-tabs).
# Lo corren los hooks de la sesión (after-split-window, pane-exited, after-kill-pane).
set -uo pipefail
s=$1
here=$(dirname "$(realpath "$0")")
"$here/caolg-tabs" "$s" sync
# Repintar bordes cuando CAO ya marcó el pane nuevo (la marca se pone justo después del split).
sleep 1
"$here/caolg-watch" "$s" --once >/dev/null 2>&1
