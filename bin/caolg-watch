#!/usr/bin/env python3
"""caolg-watch <session> [--once]: pinta bordes/tabs por provider (con carpeta y rama de cada agente), escribe la línea 2 de la barra
(~/.cache/caolg/<session>.bar) y avisa cuando el contexto de Opus pasa el límite (no limpia solo:
el /clear lo hacés vos con Alt+c). Sale cuando la sesión muere.

Env: CAOLG_WARN_AT (% de contexto de Opus para avisar, default 50; 0 = sin aviso; acepta el viejo
     CAOLG_CLEAR_AT), CAOLG_CTX_WINDOW (default 1000000, solo para el cálculo de respaldo), CAOLG_TICK (s, default 10).
"""
import json
import os
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import caolg_lib as L  # noqa: E402

API = "http://localhost:9889"
CACHE = Path.home() / ".cache/caolg"
CTX_WINDOW = int(os.environ.get("CAOLG_CTX_WINDOW", "1000000"))
WARN_AT = int(os.environ.get("CAOLG_WARN_AT") or os.environ.get("CAOLG_CLEAR_AT") or "50")
# % exacto de contexto por terminal de CAO: lo escribe la statusline de Claude Code.
CTX_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "claude/ctx"
USAGE_CACHE = CACHE / "usage.json"
TICK = int(os.environ.get("CAOLG_TICK", "10"))
USAGE_EVERY = 60
BIN = Path(os.path.realpath(__file__)).parent


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True)


def session_alive(s):
    return tmux("has-session", "-t", f"={s}").returncode == 0  # "=": nombre exacto, no prefijo


def read_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError):
        return None


def fetch_session(s):
    try:
        with urllib.request.urlopen(f"{API}/sessions/{s}", timeout=5) as r:
            return json.load(r)
    except Exception:
        return None


def fetch_usage():
    """Corre cao-usage y lo guarda en cache (lo comparten todas las sesiones y los --once)."""
    try:
        out = subprocess.run([str(BIN / "cao-usage"), "--json"], capture_output=True, text=True, timeout=120)
        data = json.loads(out.stdout)
        CACHE.mkdir(parents=True, exist_ok=True)
        USAGE_CACHE.write_text(json.dumps(data))
        return data
    except Exception:
        return cached_usage()


def cached_usage():
    try:
        return json.loads(USAGE_CACHE.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def git_where(path):
    """(raíz del repo, rama) de `path`; (path, None) si no es git. Rama detached: el sha corto."""
    out = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel", "--abbrev-ref", "HEAD"],
                         capture_output=True, text=True)
    lines = out.stdout.split()
    if out.returncode != 0 or len(lines) < 2:
        return path, None
    top, branch = lines[0], lines[1]
    if branch == "HEAD":
        branch = subprocess.run(["git", "-C", path, "rev-parse", "--short", "HEAD"],
                                capture_output=True, text=True).stdout.strip() or None
    return top, branch


def where_of(term, pane_path):
    """Carpeta y rama donde trabaja la terminal. Claude: el cwd de su statusline (sigue los `cd` del agente);
    el resto: la carpeta del proceso del pane; si no, la de CAO."""
    path = (L.cwd_from_statusline(read_json(CTX_DIR / f"{term['id']}.json")) or pane_path
            or term.get("working_directory") or "")
    if not path or not os.path.isdir(path):
        return L.where_label(path)
    return L.where_label(*git_where(path))


def paint(s, session, colors, warn=None):
    """Borde de cada pane y tab de cada ventana con el color de su provider."""
    terms = session.get("terminals", [])
    if not terms:
        return
    conductor = terms[0]["id"]
    panes = {}
    rows, extra = [], {}
    fmt = "#{pane_id}\t#{window_id}\t#{@cao_terminal}\t#{@caolg_role}\t#{@caolg_color}\t#{pane_current_path}"
    for line in tmux("list-panes", "-s", "-t", f"={s}", "-F", fmt).stdout.splitlines():
        pid, win, mark, role, ckey, ppath = (line.split("\t") + [""] * 5)[:6]
        own = tmux("show", "-p", "-qv", "-t", pid, "@cao_terminal").stdout.strip() if mark else ""
        rows.append({"id": pid, "win": win, "own": own, "inherited": mark})
        extra[pid] = (role, ckey, ppath)
    # La marca del supervisor es de ventana y se hereda a todos los panes: ver L.owner_marks.
    lid = tmux("show", "-qv", "-t", f"={s}:", "@caolg_leader").stdout.strip()
    for pid, mark in L.owner_marks(rows, lid).items():
        panes[mark] = (pid, *extra[pid])
    windows = set(tmux("list-windows", "-t", s, "-F", "#W").stdout.split())
    for t in terms:
        pid, role, ckey, ppath = panes.get(t["tmux_window"], (None, "", "", ""))
        label = L.pane_label(t, conductor, role or None)
        where = where_of(t, ppath)
        # Cada worker tiene su color fijo de tab (lo asigna caolg-tabs); Opus, el accent del tema.
        if t["id"] == conductor:
            color = colors["red"] if warn else colors["accent"]
            if warn:
                label = f"{label} · {warn}"
        elif ckey:
            color = L.tab_color(ckey, colors)
        else:
            color = L.provider_color(t.get("provider"), colors)
        if pid:
            tmux("set", "-p", "-t", pid, "@caolg_label", label)
            tmux("set", "-p", "-t", pid, "@caolg_where", where)
            if t["id"] == conductor:  # las tabs de la derecha las pinta caolg-tabs strip
                full = f"{label} · {where}" if where else label
                tmux("set", "-p", "-t", pid, "pane-border-format",
                     f"#{{?pane_active,#[fg={colors['background']}#,bg={color}#,bold],#[fg={color}]}} {full} #[default]")
                tmux("set", "-p", "-t", pid, "pane-active-border-style", f"fg={color}")
        if t["tmux_window"] in windows:  # worker que no entró como pane: es una tab propia
            tmux("set", "-w", "-t", f"{s}:{t['tmux_window']}", "window-status-format", f"#[fg={color}] #I:{label} ")
            tmux("set", "-w", "-t", f"{s}:{t['tmux_window']}", "window-status-current-format",
                 f"#[fg={colors['background']},bg={color},bold] #I:{label} ")
    subprocess.run([str(BIN / "caolg-tabs"), s, "strip"], capture_output=True)


def tick(s, state):
    session = fetch_session(s)
    if session is None:
        return
    colors = L.load_colors()
    CACHE.mkdir(parents=True, exist_ok=True)

    now = time.time()
    if now - state.get("usage_ts", 0) >= USAGE_EVERY:
        state["usage"], state["usage_ts"] = fetch_usage(), now

    terms = session.get("terminals", [])
    ctx_pct = None
    if terms:
        ctx_pct = L.ctx_from_statusline(read_json(CTX_DIR / f"{terms[0]['id']}.json"))
        if ctx_pct is None:  # sin statusline todavía: transcript más reciente de Opus en la carpeta
            cleared = tmux("show", "-qv", "-t", f"={s}:", "@caolg_cleared_at").stdout.strip()
            since = float(cleared) if cleared.replace(".", "", 1).isdigit() else 0.0
            tokens = L.opus_context_tokens(terms[0].get("working_directory", ""), since)
            if tokens is not None:
                ctx_pct = min(100, tokens * 100 // CTX_WINDOW)

    warn = L.ctx_warning(ctx_pct, WARN_AT)
    if warn and not state.get("warned"):  # una vez por cruce del límite, no cada tick
        tmux("display", "-d", "8000", "-t", f"={s}:", f"caolg: el contexto de Opus pasó el {WARN_AT}% "
             f"({ctx_pct}%). Alt+c guarda su estado y lo limpia.")
    state["warned"] = bool(warn)
    paint(s, session, colors, warn)

    usage = state.get("usage") or cached_usage()
    (CACHE / f"{s}.bar").write_text(L.build_bar(usage, colors))


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    s = sys.argv[1]
    state = {}
    if "--once" in sys.argv:
        state["usage_ts"] = time.time()  # --once no recalcula usage (lento); solo repinta
        tick(s, state)
        return
    # Un solo watcher por sesión: si ya hay uno (relanzamiento), este se va. Dos watchers duplicaban
    # los avisos y el trabajo.
    import fcntl
    CACHE.mkdir(parents=True, exist_ok=True)
    lock = open(CACHE / f"{s}.watch.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    while session_alive(s):
        tick(s, state)
        time.sleep(TICK)
    for suffix in (".bar", ".costs.json"):
        (CACHE / f"{s}{suffix}").unlink(missing_ok=True)


if __name__ == "__main__":
    main()
