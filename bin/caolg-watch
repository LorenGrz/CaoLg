#!/usr/bin/env python3
"""caolg-watch <session> [--once]: pinta bordes/tabs por provider, escribe la línea 2 de la barra
(~/.cache/caolg/<session>.bar) y dispara el /clear automático de Opus. Sale cuando la sesión muere.

Env: CAOLG_CTX_WINDOW (default 1000000: Opus en Claude Code, verificado con /context),
     CAOLG_CLEAR_AT (% de esa ventana, default 30 = 300k tokens; 0 = desactivado), CAOLG_TICK (s, default 10).
"""
import json
import os
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import caolg_lib as L  # noqa: E402

API = "http://localhost:9889"
CACHE = Path.home() / ".cache/caolg"
CTX_WINDOW = int(os.environ.get("CAOLG_CTX_WINDOW", "1000000"))
CLEAR_AT = int(os.environ.get("CAOLG_CLEAR_AT", "30"))
USAGE_CACHE = CACHE / "usage.json"
TICK = int(os.environ.get("CAOLG_TICK", "10"))
USAGE_EVERY = 60
CLEAR_COOLDOWN = 600
BIN = Path(os.path.realpath(__file__)).parent


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True)


def session_alive(s):
    return tmux("has-session", "-t", f"={s}").returncode == 0  # "=": nombre exacto, no prefijo


def fetch_session(s):
    try:
        with urllib.request.urlopen(f"{API}/sessions/{s}", timeout=5) as r:
            return json.load(r)
    except Exception:
        return None


def fetch_usage():
    """Corre cao-usage y lo guarda en cache (lo comparten todas las sesiones y los --once)."""
    try:
        out = subprocess.run([str(BIN / "cao-usage"), "--json"], capture_output=True, text=True, timeout=120)
        data = json.loads(out.stdout)
        CACHE.mkdir(parents=True, exist_ok=True)
        USAGE_CACHE.write_text(json.dumps(data))
        return data
    except Exception:
        return cached_usage()


def cached_usage():
    try:
        return json.loads(USAGE_CACHE.read_text())
    except (OSError, json.JSONDecodeError):
        return None


# provider de CAO -> agente de ccusage (para el costo por sesión)
CCUSAGE_AGENT = {"codex": "codex", "antigravity_cli": "antigravity",
                 "opencode_cli": "opencode", "copilot_cli": "copilot"}


def ccusage_sessions(agent, since_day):
    try:
        out = subprocess.run(["ccusage", agent, "session", "--json", "--since", since_day],
                             capture_output=True, text=True, timeout=90)
        return json.loads(out.stdout)
    except Exception:
        return None


def session_costs(s, session):
    """{nombre: (usd, exacto)}: Claude por carpeta (exacto); el resto desde que se abrió la sesión (≈)."""
    terms = session.get("terminals", [])
    if not terms:
        return {}
    created = tmux("display", "-p", "-t", f"={s}", "#{session_created}").stdout.strip()
    start = float(created) if created.isdigit() else time.time()
    since_day = time.strftime("%Y%m%d", time.localtime(start))
    since_iso = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(start))
    costs = {}
    claude = L.claude_costs_for_path(ccusage_sessions("claude", since_day), terms[0].get("working_directory", ""))
    for model, usd in claude.items():
        costs[model] = (usd, True)
    for prov in {t.get("provider") for t in terms[1:]}:
        agent = CCUSAGE_AGENT.get(prov)
        if agent:
            costs[L.provider_short(prov)] = (L.cost_since(ccusage_sessions(agent, since_day), since_iso), False)
    return costs


def paint(s, session, colors, opus_cost=None):
    """Borde de cada pane y tab de cada ventana con el color de su provider."""
    terms = session.get("terminals", [])
    if not terms:
        return
    conductor = terms[0]["id"]
    panes = {}
    for line in tmux("list-panes", "-s", "-t", s, "-F", "#{pane_id}\t#{@cao_terminal}").stdout.splitlines():
        pid, _, mark = line.partition("\t")
        if mark:
            panes[mark] = pid
    windows = set(tmux("list-windows", "-t", s, "-F", "#W").stdout.split())
    for t in terms:
        label = L.pane_label(t, conductor)
        if t["id"] == conductor and opus_cost is not None:
            label = f"{label} · ${opus_cost:.2f}"
        color = colors["accent"] if t["id"] == conductor else L.provider_color(t.get("provider"), colors)
        pid = panes.get(t["tmux_window"])
        if pid:
            tmux("set", "-p", "-t", pid, "@caolg_label", label)
            tmux("set", "-p", "-t", pid, "pane-border-format",
                 f"#{{?pane_active,#[fg={colors['background']}#,bg={color}#,bold],#[fg={color}]}} {label} #[default]")
            tmux("set", "-p", "-t", pid, "pane-active-border-style", f"fg={color}")
        if t["tmux_window"] in windows:  # worker que no entró como pane: es una tab propia
            tmux("set", "-w", "-t", f"{s}:{t['tmux_window']}", "window-status-format", f"#[fg={color}] #I:{label} ")
            tmux("set", "-w", "-t", f"{s}:{t['tmux_window']}", "window-status-current-format",
                 f"#[fg={colors['background']},bg={color},bold] #I:{label} ")


def tick(s, state):
    session = fetch_session(s)
    if session is None:
        return
    colors = L.load_colors()
    CACHE.mkdir(parents=True, exist_ok=True)
    costs_file = CACHE / f"{s}.costs.json"

    now = time.time()
    if now - state.get("usage_ts", 0) >= USAGE_EVERY:
        state["usage"], state["usage_ts"] = fetch_usage(), now
        state["costs"] = session_costs(s, session)
        costs_file.write_text(json.dumps(state["costs"]))
    if "costs" not in state:  # --once: reusar el último cálculo
        try:
            state["costs"] = {k: tuple(v) for k, v in json.loads(costs_file.read_text()).items()}
        except (OSError, json.JSONDecodeError):
            state["costs"] = {}
    opus = state["costs"].get("opus")
    paint(s, session, colors, opus[0] if opus else None)

    terms = session.get("terminals", [])
    ctx_pct = None
    if terms:
        cleared = tmux("show", "-v", "-t", f"={s}", "@caolg_cleared_at").stdout.strip()
        since = float(cleared) if cleared.replace(".", "", 1).isdigit() else 0.0
        tokens = L.opus_context_tokens(terms[0].get("working_directory", ""), since)
        if tokens is not None:
            ctx_pct = min(100, tokens * 100 // CTX_WINDOW)

    usage = state.get("usage") or cached_usage()
    (CACHE / f"{s}.bar").write_text(
        L.build_bar(session, ctx_pct, usage, colors, CLEAR_AT, state["costs"]))

    idle = terms and terms[0].get("status") in ("idle", "completed")
    if (CLEAR_AT and ctx_pct is not None and ctx_pct >= CLEAR_AT and idle
            and now - state.get("clear_ts", 0) >= CLEAR_COOLDOWN):
        state["clear_ts"] = now
        subprocess.Popen([str(BIN / "caolg-clear"), s], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    s = sys.argv[1]
    state = {}
    if "--once" in sys.argv:
        state["usage_ts"] = time.time()  # --once no recalcula usage ni costos (lento); solo repinta
        tick(s, state)
        return
    # Un solo watcher por sesión: si ya hay uno (relanzamiento), este se va. Dos watchers duplicaban
    # el /clear automático.
    import fcntl
    CACHE.mkdir(parents=True, exist_ok=True)
    lock = open(CACHE / f"{s}.watch.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    while session_alive(s):
        tick(s, state)
        time.sleep(TICK)
    for suffix in (".bar", ".costs.json"):
        (CACHE / f"{s}{suffix}").unlink(missing_ok=True)


if __name__ == "__main__":
    main()
